# ---------------------------------------------------------------
# Cybersecurity-Academy environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with: php bin/console key:generate
APP_KEY=
APP_DEMO_MODE=true
SUPPORT_EMAIL=support@example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=cyberacademy
DB_USERNAME=academy
DB_PASSWORD=

SESSION_LIFETIME=120
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

# log | smtp
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Cybersecurity-Academy

# demo | stripe
PAYMENT_PROVIDER=demo
PAYMENT_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900
UPLOAD_MAX_BYTES=10485760
